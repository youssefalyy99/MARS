@startuml
title MARS-OPS Use Case Diagram
skinparam shadowing false
left to right direction

actor "Colony Operator" as colonyOp
actor "Emergency Operator" as emergencyOp

rectangle "MARS-OPS System" {
  usecase "Manage crew members\nand robotic units" as UC1
  usecase "Manage facilities\nand equipment" as UC2
  usecase "Monitor resources" as UC3
  usecase "Generate colony\nstatus report" as UC4
  usecase "Submit mission" as UC5
  usecase "Assign agents" as UC6
  usecase "Execute mission" as UC7
  usecase "Monitor mission" as UC8
  usecase "Advance simulation time" as UC9
  usecase "Monitor environmental\nconditions" as UC10
  usecase "Trigger and handle\nemergencies" as UC11
  usecase "Inspect mission and\nemergency outcomes" as UC12

  usecase "Check agent capability\nand availability" as UC13
  usecase "Check colony-wide\nresources" as UC14
  usecase "Dispatch responders" as UC15
  usecase "Reject mission\n(FAILED with reason)" as UC16
  usecase "Fail mission in progress" as UC17
  usecase "Mark emergency\nUNRESOLVED" as UC18
}

colonyOp --> UC1
colonyOp --> UC2
colonyOp --> UC3
colonyOp --> UC4
colonyOp --> UC5
colonyOp --> UC7
colonyOp --> UC8
colonyOp --> UC9
colonyOp --> UC10
colonyOp --> UC12

emergencyOp --> UC10
emergencyOp --> UC11
emergencyOp --> UC12
emergencyOp --> UC3

' include = always required
UC5 ..> UC6 : <<include>>
UC6 ..> UC13 : <<include>>
UC5 ..> UC14 : <<include>>
UC4 ..> UC3 : <<include>>
UC7 ..> UC9 : <<include>>
UC11 ..> UC15 : <<include>>
UC11 ..> UC14 : <<include>>

' extend = conditional behaviour
UC16 ..> UC5 : <<extend>>\n[validation fails]
UC17 ..> UC7 : <<extend>>\n[environment, battery\nor damage]
UC18 ..> UC11 : <<extend>>\n[responders or\nresources unavailable]
@enduml
